# ==============================================================================
# CONFIGURACIÓN DEL SISTEMA DE BONIFICACIONES - INTERELÉCTRICOS GROUP SAS
# ==============================================================================

# 1. Configuración Green API (Integración WhatsApp)
GREEN_HOST=https://7107.api.greenapi.com
ID_INSTANCE=tu_id_instance_aqui
API_TOKEN_INSTANCE=tu_api_token_aqui
# Lista separada por comas de números autorizados (ej: 573001234567@c.us)
CHAT_ID_PRUEBA=573000000000@c.us

# 2. Configuración Gemini API (Google AI Studio)
GEMINI_API_KEY=tu_api_key_de_gemini_aqui
GEMINI_MODEL=gemini-3.5-flash

# 3. Configuración Google Sheets (Base de Datos Transaccional)
GOOGLE_SHEET_ID=tu_id_del_google_sheet_aqui
# Ruta relativa a la raíz o absoluta al JSON de Service Account
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service_account.json
# Alternativa para entornos Serverless o Cloud (contenido JSON en una sola línea):
GOOGLE_CREDENTIALS_JSON=

# 4. Configuración Operativa y Logging
LOG_LEVEL=INFO
TIMEZONE=America/Bogota

